# Project root
PROJECT_ROOT_DIR=.

# LLM provider configuration
AUDITOR_LLM_API_KEY=replace-with-api-key
AUDITOR_LLM_MODEL=replace-with-model-name
AUDITOR_LLM_URL=https://example-llm-endpoint/v1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_SINK=stdout
LOG_ROOT_DIR=logs
LOG_FILE=a11y-llm.log
LOG_ROTATE_MAX_BYTES=5242880
LOG_ROTATE_BACKUP_COUNT=5
LOG_SERVICE_NAME=a11y-llm

# Allure
ALLURE_ENABLED=true
ALLURE_ROOT_DIR=allure
ALLURE_RESULTS_SUBDIR=results
ALLURE_REPORT_SUBDIR=report
ALLURE_CLEAN_RESULTS=false

# Playwright runtime
PW_HEADLESS=true
PW_SLOW_MO_MS=0
PW_LAUNCH_TIMEOUT_MS=30000
PW_ACTION_TIMEOUT_MS=10000
PW_NAVIGATION_TIMEOUT_MS=20000
PW_IGNORE_HTTPS_ERRORS=true
